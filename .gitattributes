# Finales de linea: en el repositorio todo se guarda con LF, sin importar el editor de cada uno.
# (Railway y Docker corren en Linux; los editores de Windows trabajan bien con LF)
* text=auto eol=lf

# codigo y texto: siempre texto (asi git no los confunde con archivos binarios)
*.py           text eol=lf
*.js           text eol=lf
*.jsx          text eol=lf
*.css          text eol=lf
*.html         text eol=lf
*.json         text eol=lf
*.md           text eol=lf
*.txt          text eol=lf
*.yml          text eol=lf
*.ini          text eol=lf
*.example      text eol=lf
*.dockerignore text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
Dockerfile     text eol=lf
Caddyfile      text eol=lf
LICENSE        text eol=lf

# scripts de PowerShell: solo se usan en Windows
*.ps1          text eol=crlf

# binarios: no se tocan
*.png          binary
*.jpg          binary
*.jpeg         binary
*.gif          binary
*.ico          binary
*.webp         binary
*.pdf          binary
*.gz           binary
