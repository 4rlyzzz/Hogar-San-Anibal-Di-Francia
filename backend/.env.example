# Copiar como backend/.env para desarrollo en tu PC (nunca subir el .env al repositorio).
# En Railway estas mismas variables van en el servicio "backend" -> Variables (ver DESPLIEGUE.md).

# Clave de Django. Generar una con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# True solo en tu PC. En Railway NO se pone (queda en modo produccion).
DEBUG=True

ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cuenta con la que Django usa CouchDB todos los dias (NO es el administrador de CouchDB)
COUCHDB_URL=http://127.0.0.1:5984
COUCHDB_USER=casa_app
COUCHDB_PASSWORD=

# Nombres de las bases (opcional: estos son los valores por defecto)
COUCHDB_DB_USUARIOS=casa_usuarios
COUCHDB_DB_INVENTARIO=casa_inventario
COUCHDB_DB_DONADORES=casa_donadores
COUCHDB_DB_MOVIMIENTOS=casa_movimientos
COUCHDB_DB_PROVEEDORES=casa_proveedores
COUCHDB_DB_COMPRADORES=casa_compradores

# Administrador de CouchDB: solo para "python manage.py setup_couch".
# En Railway se puede quitar despues de la primera vez.
COUCHDB_ADMIN_USER=admin
COUCHDB_ADMIN_PASSWORD=

# Dictado con IA (opcional). Sin IA_1_URL el dictado usa solo el reconocimiento local.
# Un grupo de variables por proveedor (IA_1, IA_2...): el numero es el orden en que se prueban, y dentro
# de cada uno sus modelos en el orden escrito. Si uno falla (limite del dia, caido, lento), va el siguiente.
#   IA_N_URL      Groq: https://api.groq.com/openai
#                 Gemini (va con la direccion completa): https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
#                 OmniRoute en tu PC: http://localhost:20128
#   IA_N_KEY      la clave de ese proveedor (Groq empieza con gsk_; Gemini, de Google AI Studio)
#   IA_N_MODELOS  separados por coma, tal cual los nombra el proveedor (en OmniRoute: el nombre del combo)
IA_1_URL=https://api.groq.com/openai
IA_1_KEY=
IA_1_MODELOS=openai/gpt-oss-20b,openai/gpt-oss-120b
IA_2_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
IA_2_KEY=
IA_2_MODELOS=gemini-3.1-flash-lite,gemini-2.5-flash
# Opcionales (ya tienen valor por defecto):
# IA_N_REASONING=low    cuanto "piensa" el modelo; vacio si ese proveedor rechaza reasoning_effort (error 400)
# IA_MAX_TOKENS=1500    sube a 3000 si la respuesta llega vacia
# IA_ESPERA=10          segundos de espera por modelo antes de pasar al siguiente
