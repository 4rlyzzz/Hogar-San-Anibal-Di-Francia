# Copiar como backend/.env para desarrollo en tu PC (nunca subir el .env al repositorio).
# En Railway estas mismas variables van en el servicio "backend" -> Variables (ver DESPLIEGUE.md).

# Clave de Django. Generar una con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# True solo en tu PC. En Railway NO se pone (queda en modo produccion).
DEBUG=True

ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cuenta con la que Django usa CouchDB todos los dias (NO es el administrador de CouchDB)
COUCHDB_URL=http://127.0.0.1:5984
COUCHDB_USER=casa_app
COUCHDB_PASSWORD=

# Nombres de las bases (opcional: estos son los valores por defecto)
COUCHDB_DB_USUARIOS=casa_usuarios
COUCHDB_DB_INVENTARIO=casa_inventario
COUCHDB_DB_DONADORES=casa_donadores
COUCHDB_DB_MOVIMIENTOS=casa_movimientos
COUCHDB_DB_PROVEEDORES=casa_proveedores
COUCHDB_DB_COMPRADORES=casa_compradores

# Administrador de CouchDB: solo para "python manage.py setup_couch".
# En Railway se puede quitar despues de la primera vez.
COUCHDB_ADMIN_USER=admin
COUCHDB_ADMIN_PASSWORD=

# Dictado con IA (opcional). Vacio = el dictado usa solo el reconocimiento local.
# Sirve OmniRoute o un proveedor directo (el nombre OMNIROUTE_ quedo por OmniRoute):
#   OmniRoute en tu PC: OMNIROUTE_URL=http://localhost:20128            MODEL = el nombre del combo
#   Groq directo:       OMNIROUTE_URL=https://api.groq.com/openai       MODEL = openai/gpt-oss-20b u openai/gpt-oss-120b
#   Gemini directo:     OMNIROUTE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
#                       MODEL = gemini-2.5-flash (Gemini va con la direccion completa)
# OMNIROUTE_API_KEY es la clave de ese servicio (la de OmniRoute, Groq o Google AI Studio).
OMNIROUTE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=inventario-fallback
# Opcionales (ya tienen valor por defecto). Si un modelo rechaza reasoning_effort, dejalo vacio.
# OMNIROUTE_REASONING_EFFORT=low
# OMNIROUTE_MAX_TOKENS=1500
